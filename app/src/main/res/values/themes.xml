<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ThemeSwitchDemo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- KSU 同款：启用预测性手势返回（Android 13+） -->
        <item name="android:enableOnBackInvokedCallback">true</item>
    </style>

    <style name="Theme.ThemeSwitchDemo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/background_light</item>
        <item name="postSplashScreenTheme">@style/Theme.ThemeSwitchDemo</item>
    </style>
</resources>
